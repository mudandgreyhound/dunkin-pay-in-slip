# dunkin-pay-in-slip — ค่าตั้งต้น (คัดลอกเป็น .env)
APP_HOST=0.0.0.0
APP_PORT=8608
ALLOWED_ORIGINS=https://dunkin-pay-in-slip.mobile1234.site,http://localhost:8608

# ฐานข้อมูล GD_Dashboard (อ่าน dim_shop/shop_location, เขียน payin_*)
DB_HOST=10.8.1.88
DB_PORT=3306
DB_NAME=GD_Dashboard
DB_USER=admin
DB_PASSWORD=CHANGE_ME

# กุญแจเซ็น session cookie — สร้างด้วย: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME

# cookie secure=1 เมื่อเสิร์ฟผ่าน https (cloudflared) ; ตั้ง 0 ถ้าทดสอบผ่าน http ตรง ๆ
COOKIE_SECURE=1
